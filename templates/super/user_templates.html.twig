{#
  Dashboard template manager. Rendered by
  OpenEMR\Controllers\Interface\Super\UserTemplateManagerController.

  Top: the template type and the saved templates, with an Active checkbox
  each (at most one checked; none means the core card). Left: the preview
  (rendered in the sandbox with made-up data, in a frame that allows no
  scripts) and the available fields. Right: the editor for the selected
  template with Check, Save draft, Publish and Save as new template, the
  check result and the fields the template uses.
  Autoescape is off in OpenEMR, so every value goes through |text, |attr or
  a translation filter.

  @package   OpenEMR
  @link      https://www.open-emr.org
  @author    David Eschelbacher
  @copyright Copyright (c) 2026 David Eschelbacher
  @license   https://github.com/openemr/openemr/blob/master/LICENSE GNU General Public License 3
#}
<html>
<head>
    <title>{{ 'Dashboard Templates'|xlt }}</title>
    {{ setupHeader([], false) }}
</head>
<body class="body_top">
<div class="container-fluid mt-3">
    <div class="d-flex justify-content-between align-items-start mb-2">
        <form method="get" class="form-inline mb-0">
            <label for="template_type" class="font-weight-bold mr-2">{{ 'Template Type'|xlt }}:</label>
            <select id="template_type" name="type" class="form-control form-control-sm">
                {% for type in templateTypes %}
                    <option value="{{ type.value|attr }}"{% if type.value == templateType %} selected{% endif %}{% if not type.available %} disabled{% endif %}>{{ type.label|xlt }}</option>
                {% endfor %}
            </select>
        </form>
        <div class="alert alert-info py-1 px-2 mb-0 small">
            <span class="badge badge-info">{{ 'Experimental'|xlt }}</span>
            {{ 'Templates run in a sandbox: they can only show the available fields, and cannot run code, read files or query the database.'|xlt }}
        </div>
    </div>

    {% if not featureEnabled %}
        <div class="alert alert-warning">{{ 'Active templates are not shown yet: turn on "Enable Admin-Uploaded Dashboard Templates" in Administration > Globals > Appearance first.'|xlt }}</div>
    {% endif %}
    {% if message %}
        <div class="alert alert-info">{{ message|text }}</div>
    {% endif %}

    <form method="post" id="activate-form" class="mb-3">
        <input type="hidden" name="csrf_token_form" value="{{ csrfToken|attr }}">
        <input type="hidden" name="action" value="activate">
        <input type="hidden" name="template_name" value="{{ selected|attr }}">
        {% if templates is empty %}
            <p class="text-muted mb-0">{{ 'No templates yet. Edit the starter below and save it as a new template.'|xlt }}</p>
        {% else %}
            <table class="table table-sm table-bordered w-auto mb-1">
                <thead class="thead-light">
                    <tr><th>{{ 'Active'|xlt }}</th><th>{{ 'Name'|xlt }}</th><th>{{ 'Published version'|xlt }}</th><th>{{ 'Draft'|xlt }}</th></tr>
                </thead>
                <tbody>
                {% for template in templates %}
                    <tr{% if template.name == selected %} class="table-active"{% endif %}>
                        <td class="text-center">
                            <input type="checkbox" class="js-active-template" value="{{ template.name|attr }}"
                                aria-label="{{ 'Active'|xla }}: {{ template.name|attr }}"
                                {% if template.active %} checked{% endif %}
                                {% if not template.published %} disabled title="{{ 'Publish the template before making it active.'|xla }}"{% endif %}>
                        </td>
                        <td>
                            <a href="?template={{ template.name|url_encode|attr }}">{{ template.name|text }}</a>
                            {% if template.name == selected %}<span class="text-muted small">({{ 'editing'|xlt }})</span>{% endif %}
                        </td>
                        <td>
                            {% if template.published %}
                                #{{ template.published.id|text }}, {{ template.published.by|text }} {{ template.published.at|text }}
                            {% else %}
                                <span class="text-muted">{{ 'not published'|xlt }}</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if template.draft %}
                                <span class="badge badge-warning">{{ 'Unpublished draft'|xlt }}</span> #{{ template.draft.id|text }}
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
            <small class="text-muted">
                {% if activeName %}
                    {{ 'The dashboard shows the checked template. Uncheck it to use the core card.'|xlt }}
                {% else %}
                    {{ 'No template is checked, so the dashboard shows the core Demographics card.'|xlt }}
                {% endif %}
            </small>
        {% endif %}
    </form>

    <div class="row">
        <div class="col-lg-6 mb-3">
            <div class="font-weight-bold mb-1">{{ 'Preview'|xlt }}</div>
            {% if previewDocument %}
                <div class="embed-responsive embed-responsive-4by3 border rounded bg-white">
                    {# allow-same-origin only so the theme stylesheet loads; without allow-scripts no script can run, and the page's own CSP blocks scripts too. #}
                    <iframe sandbox="allow-same-origin" title="{{ 'Template preview'|xla }}" class="embed-responsive-item" srcdoc="{{ previewDocument|attr }}"></iframe>
                </div>
            {% else %}
                <div class="border rounded p-3 text-muted">{{ 'Fix the problems on the right to see a preview.'|xlt }}</div>
            {% endif %}
        </div>

        <div class="col-lg-6 mb-3">
            <form method="post" id="template-form">
                <input type="hidden" name="csrf_token_form" value="{{ csrfToken|attr }}">
                <input type="hidden" name="draft_id" value="{{ draft ? draft.id|attr : '' }}">
                <input type="hidden" name="template_name" value="{{ selected|attr }}">
                <label for="source" class="font-weight-bold mb-1">
                    {% if selected %}{{ 'Editing'|xlt }}: {{ selected|text }}{% else %}{{ 'New template'|xlt }}{% endif %}
                </label>
                <textarea id="source" name="source" class="form-control text-monospace small" rows="24" spellcheck="false">{{ source|text }}</textarea>

                <div class="mt-2">
                    <button type="submit" name="action" value="check" class="btn btn-secondary">{{ 'Check and preview'|xlt }}</button>
                    {% if selected %}
                        <button type="submit" name="action" value="save_draft" class="btn btn-primary">{{ 'Save draft'|xlt }}</button>
                    {% endif %}
                    {% if draft %}
                        <button type="submit" name="action" value="publish" class="btn btn-success">{{ 'Publish draft'|xlt }} #{{ draft.id|text }}</button>
                    {% endif %}
                </div>
                <div class="input-group input-group-sm mt-2">
                    <label class="sr-only" for="new_name">{{ 'New template name'|xlt }}</label>
                    <input type="text" id="new_name" name="new_name" class="form-control" maxlength="100" placeholder="{{ 'New template name'|xla }}">
                    <div class="input-group-append">
                        <button type="submit" name="action" value="save_as_new" class="btn btn-outline-primary">{{ 'Save as new template'|xlt }}</button>
                    </div>
                </div>
            </form>

            <div class="mt-2">
                {% if issues is empty %}
                    <div class="alert alert-success py-2 mb-0">{{ 'Check passed.'|xlt }}</div>
                {% else %}
                    <div class="alert alert-danger py-2 mb-0">
                        <strong>{{ 'Check found problems'|xlt }}:</strong>
                        <ul class="mb-0">
                            {% for issue in issues %}
                                <li>{% if issue.line is not null %}{{ 'Line'|xlt }} {{ issue.line|text }}: {% endif %}{{ issue.message|text }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-6 mb-3">
            <div class="font-weight-bold mb-1">{{ 'Available Fields'|xlt }} <span class="text-muted font-weight-normal">({{ 'dataset version'|xlt }} {{ datasetVersion|text }})</span></div>
            <table class="table table-sm table-striped small mb-0">
                <thead><tr><th>{{ 'Field'|xlt }}</th><th>{{ 'Meaning'|xlt }}</th><th>{{ 'Type'|xlt }}</th><th>{{ 'Example'|xlt }}</th></tr></thead>
                <tbody>
                {% for field in fields %}
                    <tr>
                        <td><code>{{ field.name|text }}</code></td>
                        <td>{{ field.label|text }}</td>
                        <td>{{ field.type|text }}</td>
                        <td>{{ field.sample|text }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="col-lg-6 mb-3">
            <div class="font-weight-bold mb-1">{{ 'Fields used'|xlt }}</div>
            {% if usedFields is empty %}
                <p class="text-muted small mb-0">{{ 'None yet.'|xlt }}</p>
            {% else %}
                <ul class="list-unstyled small mb-0">
                    {% for field in usedFields %}
                        <li><code>{{ rootName|text }}.{{ field|text }}</code></li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>
    </div>
</div>
<script>
    // At most one Active box is checked: checking one makes it the active
    // template, unchecking it goes back to the core card.
    document.querySelectorAll('.js-active-template').forEach(function (box) {
        box.addEventListener('change', function () {
            var form = document.getElementById('activate-form');
            document.querySelectorAll('.js-active-template').forEach(function (other) {
                if (other !== box) {
                    other.checked = false;
                }
            });
            form.elements.action.value = box.checked ? 'activate' : 'revert';
            form.elements.template_name.value = box.value;
            form.submit();
        });
    });
</script>
</body>
</html>
